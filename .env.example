# Variables de entorno para FumiControl Backend
# Copia este archivo como .env y ajusta los valores

# ================================
# SERVIDOR
# ================================
PORT=3000
NODE_ENV=development

# ================================
# BASE DE DATOS PostgreSQL
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fumicontrol
DB_USER=fumicontrol
DB_PASSWORD=fumicontrol_dev

# ================================
# VIGENCIAS
# ================================
# Días antes del vencimiento para considerar "próxima a vencer"
EXPIRATION_ALERT_DAYS=7
